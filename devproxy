#!/usr/bin/env bash
# ==============================================================================
# DevProxy CLI v1.1.0 for Linux & macOS
# Universal proxy injector & switcher for Cursor, VS Code, Windsurf, VSCodium, Git & Shell
# https://github.com/j46871417-ui/devproxy
# ==============================================================================

set -e

VERSION="v1.1.0"

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Helper for cross-platform in-place sed
sedi() {
    if [ "$(uname)" = "Darwin" ]; then
        sed -i '' "$@"
    else
        sed -i "$@"
    fi
}

normalize_proxy() {
    local raw="$1"
    raw="$(echo "$raw" | tr -d '\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^["'"'"']//' -e 's/["'"'"']$//')"

    if [ -z "$raw" ]; then
        echo ""
        return
    fi

    case "$raw" in
        http://*|https://*|socks5://*|socks5h://*)
            echo "$raw"
            return
            ;;
    esac

    # Check for host:port:user:pass (4 colons)
    local colon_count
    colon_count=$(echo "$raw" | awk -F: '{print NF-1}')
    if [ "$colon_count" -eq 3 ]; then
        local host port user pass
        host=$(echo "$raw" | cut -d: -f1)
        port=$(echo "$raw" | cut -d: -f2)
        user=$(echo "$raw" | cut -d: -f3)
        pass=$(echo "$raw" | cut -d: -f4)
        echo "http://${user}:${pass}@${host}:${port}"
        return
    fi

    # Check for host:port (1 colon)
    if [ "$colon_count" -eq 1 ]; then
        echo "http://${raw}"
        return
    fi

    echo "http://${raw}"
}

get_ide_configs() {
    local home_dir="${HOME:-$HOME}"
    cat <<EOF
Cursor:${home_dir}/.config/Cursor/User/settings.json
VS Code:${home_dir}/.config/Code/User/settings.json
Windsurf:${home_dir}/.config/Windsurf/User/settings.json
VSCodium:${home_dir}/.config/VSCodium/User/settings.json
Antigravity IDE:${home_dir}/.config/Antigravity/User/settings.json
VS Code (Flatpak):${home_dir}/.var/app/com.visualstudio.code/config/Code/User/settings.json
Cursor (macOS):${home_dir}/Library/Application Support/Cursor/User/settings.json
VS Code (macOS):${home_dir}/Library/Application Support/Code/User/settings.json
Windsurf (macOS):${home_dir}/Library/Application Support/Windsurf/User/settings.json
EOF
}

strip_comments_json() {
    local file="$1"
    # Safe python / perl / sed comment stripper
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import sys, re
with open('$file', 'r', encoding='utf-8') as f:
    text = f.read()
out = []
in_string = False
escape = False
i = 0
n = len(text)
while i < n:
    c = text[i]
    if in_string:
        out.append(c)
        if escape: escape = False
        elif c == '\\\\': escape = True
        elif c == '\"': in_string = False
        i += 1
        continue
    if c == '\"':
        in_string = True
        out.append(c)
        i += 1
        continue
    if c == '/' and i + 1 < n:
        if text[i+1] == '/':
            while i < n and text[i] != '\n': i += 1
            if i < n: out.append(text[i]); i += 1
            continue
        elif text[i+1] == '*':
            i += 2
            while i + 1 < n and not (text[i] == '*' and text[i+1] == '/'): i += 1
            i += 2
            continue
    out.append(c)
    i += 1
res = ''.join(out)
res = re.sub(r',\s*([\}\]])', r'\1', res)
print(res)
"
    else
        # Fallback sed
        sed -e 's://.*$::g' "$file" | sed -e 's:/[*].*[*]/::g'
    fi
}

update_ide_settings() {
    local path="$1"
    local proxy_url="$2"
    local dir
    dir="$(dirname "$path")"

    mkdir -p "$dir"

    if [ -f "$path" ]; then
        cp -f "$path" "${path}.bak" 2>/dev/null || true
    else
        echo "{}" > "$path"
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, os, re, sys
path = '$path'
proxy = '$proxy_url'
try:
    with open(path, 'r', encoding='utf-8') as f: raw = f.read()
    raw = re.sub(r'//.*', '', raw)
    raw = re.sub(r'/\*.*?\*/', '', raw, flags=re.DOTALL)
    raw = re.sub(r',\s*([\}\]])', r'\1', raw)
    data = json.loads(raw) if raw.strip() else {}
except Exception:
    data = {}
data['http.proxy'] = proxy
data['http.proxyStrictSSL'] = False
data['http.proxySupport'] = 'on'
with open(path, 'w', encoding='utf-8') as f:
    json.dump(data, f, indent=4, ensure_ascii=False)
"
    else
        # Pure sed/awk manipulation
        sedi '/"http\.proxy"/d' "$path" 2>/dev/null || true
        sedi '/"http\.proxyStrictSSL"/d' "$path" 2>/dev/null || true
        sedi '/"http\.proxySupport"/d' "$path" 2>/dev/null || true
        sedi 's/^[[:space:]]*{[[:space:]]*/{\n  "http.proxy": "'"$proxy_url"'",\n  "http.proxyStrictSSL": false,\n  "http.proxySupport": "on",/g' "$path"
    fi
}

clean_ide_settings() {
    local path="$1"
    [ -f "$path" ] || return 0

    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, re
path = '$path'
try:
    with open(path, 'r', encoding='utf-8') as f: raw = f.read()
    raw = re.sub(r'//.*', '', raw)
    raw = re.sub(r'/\*.*?\*/', '', raw, flags=re.DOTALL)
    raw = re.sub(r',\s*([\}\]])', r'\1', raw)
    data = json.loads(raw)
    changed = False
    for k in ['http.proxy', 'http.proxyStrictSSL', 'http.proxySupport']:
        if k in data:
            del data[k]
            changed = True
    if changed:
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=4, ensure_ascii=False)
except Exception:
    pass
"
    else
        sedi '/"http\.proxy"/d' "$path" 2>/dev/null || true
        sedi '/"http\.proxyStrictSSL"/d' "$path" 2>/dev/null || true
        sedi '/"http\.proxySupport"/d' "$path" 2>/dev/null || true
    fi
}

update_shell_env() {
    local proxy_url="$1"
    local rc_files=("$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile")

    for rc in "${rc_files[@]}"; do
        if [ -f "$rc" ] || [ "$rc" = "$HOME/.bashrc" ]; then
            touch "$rc"
            # Strip previous block if exists
            sedi '/# >>> devproxy proxy configuration >>>/,/# <<< devproxy proxy configuration <<</d' "$rc" 2>/dev/null || true

            cat <<EOF >> "$rc"
# >>> devproxy proxy configuration >>>
export http_proxy="$proxy_url"
export https_proxy="$proxy_url"
export all_proxy="$proxy_url"
export HTTP_PROXY="$proxy_url"
export HTTPS_PROXY="$proxy_url"
export ALL_PROXY="$proxy_url"
export no_proxy="localhost,127.0.0.1,::1"
export NO_PROXY="localhost,127.0.0.1,::1"
# <<< devproxy proxy configuration <<<
EOF
        fi
    done

    export http_proxy="$proxy_url"
    export https_proxy="$proxy_url"
    export all_proxy="$proxy_url"
    export HTTP_PROXY="$proxy_url"
    export HTTPS_PROXY="$proxy_url"
    export ALL_PROXY="$proxy_url"
}

clean_shell_env() {
    local rc_files=("$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile")
    for rc in "${rc_files[@]}"; do
        if [ -f "$rc" ]; then
            sedi '/# >>> devproxy proxy configuration >>>/,/# <<< devproxy proxy configuration <<</d' "$rc" 2>/dev/null || true
        fi
    done
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY no_proxy NO_PROXY || true
}

test_connection() {
    local proxy_url="$1"
    printf "  ${CYAN}?${NC} Проверка связи через прокси... "

    local endpoints=(
        "https://generativelanguage.googleapis.com"
        "https://www.google.com"
    )

    for ep in "${endpoints[@]}"; do
        local code
        code=$(curl -s -o /dev/null -w "%{http_code}" -x "$proxy_url" --max-time 7 "$ep" 2>/dev/null || echo "000")
        if [ "$code" = "200" ] || [ "$code" = "404" ] || [ "$code" = "403" ] || [ "$code" = "400" ]; then
            printf "${GREEN}УСПЕХ! Прокси работает корректно (Код %s).${NC}\n" "$code"
            return 0
        fi
    done

    printf "${YELLOW}ПРЕДУПРЕЖДЕНИЕ: Соединение медленное или хост ограничен.${NC}\n"
}

apply_proxy() {
    local proxy_url="$1"
    printf "\n${CYAN}${BOLD}[+] Применяем прокси: %s${NC}\n" "$proxy_url"

    # 1. IDEs
    while IFS=: read -r name path; do
        [ -z "$name" ] && continue
        local dir
        dir="$(dirname "$path")"
        if [ -d "$dir" ] || [ -f "$path" ]; then
            update_ide_settings "$path" "$proxy_url"
            printf "  ${GREEN}✓${NC} %-20s: обновлен (%s)\n" "$name" "$path"
        fi
    done < <(get_ide_configs)

    # 2. Shell Environment
    update_shell_env "$proxy_url"
    printf "  ${GREEN}✓${NC} %-20s: добавлены в ~/.bashrc, ~/.zshrc, ~/.profile\n" "Shell Environment"

    # 3. Git
    if command -v git >/dev/null 2>&1; then
        git config --global http.proxy "$proxy_url" || true
        git config --global https.proxy "$proxy_url" || true
        printf "  ${GREEN}✓${NC} %-20s: http.proxy и https.proxy обновлены\n" "Git Global Config"
    fi

    # 4. Test
    test_connection "$proxy_url"

    printf "\n${GREEN}${BOLD}[✓] ГОТОВО! Прокси успешно внедрен во все редакторы и терминал.${NC}\n"
    printf "${YELLOW}Совет: Если редактор уже открыт, перезапустите его (Ctrl+Shift+P -> Reload Window).${NC}\n\n"
}

show_status() {
    printf "\n${CYAN}${BOLD}=== ТЕКУЩИЙ СТАТУС НАСТРОЕК ПРОКСИ ===${NC}\n"
    while IFS=: read -r name path; do
        [ -z "$name" ] && continue
        if [ -f "$path" ]; then
            local val
            val=$(grep -o '"http\.proxy"[[:space:]]*:[[:space:]]*"[^"]*"' "$path" 2>/dev/null | head -n1 | cut -d'"' -f4 || echo "")
            if [ -n "$val" ]; then
                printf "  * %-20s: %s\n" "$name" "$val"
            else
                printf "  * %-20s: не настроен\n" "$name"
            fi
        fi
    done < <(get_ide_configs)

    local cur_http="${http_proxy:-${HTTP_PROXY:-не задана}}"
    local cur_https="${https_proxy:-${HTTPS_PROXY:-не задана}}"
    printf "  * %-20s: %s\n" "http_proxy" "$cur_http"
    printf "  * %-20s: %s\n" "https_proxy" "$cur_https"

    if command -v git >/dev/null 2>&1; then
        local git_p
        git_p=$(git config --global http.proxy 2>/dev/null || echo "не задан")
        printf "  * %-20s: %s\n" "git http.proxy" "$git_p"
    fi
    echo ""
}

remove_all() {
    printf "\n${YELLOW}[-] Сбрасываем и удаляем прокси со всех сред...${NC}\n"

    while IFS=: read -r name path; do
        [ -z "$name" ] && continue
        if [ -f "$path" ]; then
            clean_ide_settings "$path"
            printf "  ${GREEN}✓${NC} %-20s: очищен\n" "$name"
        fi
    done < <(get_ide_configs)

    clean_shell_env
    printf "  ${GREEN}✓${NC} %-20s: переменные удалены из ~/.bashrc, ~/.zshrc, ~/.profile\n" "Shell Environment"

    if command -v git >/dev/null 2>&1; then
        git config --global --unset http.proxy 2>/dev/null || true
        git config --global --unset https.proxy 2>/dev/null || true
        printf "  ${GREEN}✓${NC} %-20s: настройки очищены\n" "Git Global Config"
    fi

    printf "\n${GREEN}[✓] Все настройки прокси успешно сброшены.${NC}\n\n"
}

show_help() {
    echo "DevProxy CLI ${VERSION} for Linux & macOS"
    echo "Универсальная утилита внедрения прокси в среды разработки."
    echo ""
    echo "Использование:"
    echo "  devproxy [ПРОКСИ]         - Применить прокси"
    echo "  devproxy --status         - Показать текущий статус"
    echo "  devproxy --remove         - Очистить настройки прокси"
    echo "  devproxy --help           - Показать справку"
    echo ""
    echo "Поддерживаемые форматы:"
    echo "  http://user:pass@host:port"
    echo "  host:port:user:pass"
    echo "  socks5://host:port"
    echo "  host:port"
    echo ""
}

main() {
    if [ "$#" -gt 0 ]; then
        case "$1" in
            --remove|-r|clean|remove)
                remove_all
                exit 0
                ;;
            --status|-s|status)
                show_status
                exit 0
                ;;
            --help|-h|help)
                show_help
                exit 0
                ;;
            *)
                local norm
                norm=$(normalize_proxy "$1")
                if [ -n "$norm" ]; then
                    apply_proxy "$norm"
                    exit 0
                else
                    printf "${RED}[-] Ошибка: Неверный формат прокси.${NC}\n" >&2
                    exit 1
                fi
                ;;
        esac
    fi

    # Interactive menu
    while true; do
        printf "${CYAN}${BOLD}\n"
        echo "============================================================"
        echo "  [+] DevProxy CLI ${VERSION} (Linux / macOS)"
        echo "      Универсальная настройка Cursor, VS Code, Windsurf, Git"
        echo "============================================================"
        printf "${NC}"
        echo "  [1] Встроить / обновить прокси (вставить строку или ссылку)"
        echo "  [2] Проверить текущий статус настроек"
        echo "  [3] Отключить / удалить прокси со всех IDE и терминала"
        echo "  [0] Выход"
        printf "${CYAN}------------------------------------------------------------${NC}\n"

        read -r -p "Выберите действие [0-3]: " choice || break
        case "$choice" in
            1)
                echo ""
                echo "Вставьте строку прокси в любом формате:"
                echo "  - http://username:password@1.2.3.4:8080"
                echo "  - 1.2.3.4:8080:username:password"
                echo "  - socks5://1.2.3.4:1080"
                echo "  - 1.2.3.4:8080"
                read -r -p $'\nПрокси: ' input || break
                if [ -n "$input" ]; then
                    local norm
                    norm=$(normalize_proxy "$input")
                    if [ -n "$norm" ]; then
                        apply_proxy "$norm"
                    else
                        printf "${RED}[-] Неверный формат прокси.${NC}\n"
                    fi
                fi
                ;;
            2)
                show_status
                ;;
            3)
                remove_all
                ;;
            0|q|exit)
                echo "Завершение работы."
                break
                ;;
            *)
                echo "Неизвестный пункт меню."
                ;;
        esac
    done
}

main "$@"
